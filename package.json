{
  "name": "delivery-status-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "db:migrate:local": "wrangler d1 migrations apply delivery-status --local",
    "db:migrate:remote": "wrangler d1 migrations apply delivery-status --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^26.2.0",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
